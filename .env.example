# Copy to .env and fill in. .env is ignored by git.
# Hugging Face token: Gemma-3 is a gated model (accept its license on huggingface.co first).
HF_TOKEN=
# OpenRouter key: the judge (GPT-4o-mini) for answers the rule-based routes cannot decide.
OPENROUTER_API_KEY=
# Set to 1 once models and lenses are in the local HF cache (e.g. on a machine without internet).
HF_HUB_OFFLINE=0
